<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US">

  <info>
    <title>BibTeX Key Citations</title>
    <id>https://example.com/key-citations</id>
    <updated>2026-08-17T00:00:00+00:00</updated>
  </info>

  <citation>
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-key"/>
    </layout>
  </citation>

  <bibliography>
    <layout>
      <text variable="citation-key"/>
    </layout>
  </bibliography>
</style>
